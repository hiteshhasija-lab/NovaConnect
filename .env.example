# NovaConnect settings for compose.yaml. Copy to .env and fill in; never commit .env.
# Generate each secret with:  openssl rand -hex 32   (hex only, so nothing needs quoting)

# ---- Required -------------------------------------------------------------------------------

NODE_ENV=production

# Database (the postgres service is created with these on first start)
PGUSER=novaconnect
PGPASSWORD=
PGDATABASE=novaconnect

# Signs session cookies. At least 32 characters.
SESSION_SECRET=

# Redis (sessions) and Meilisearch (search) passwords. MEILI_API_KEY at least 16 characters.
REDIS_PASSWORD=
MEILI_API_KEY=

# The server's IP address as browsers reach it (e.g. its LAN IP). Calls and meetings send media
# straight to this address on UDP 40000-49999; without it, people can join but see/hear nothing.
MEDIASOUP_ANNOUNCED_IP=

# The first admin account, created on first start when the database is empty (ignored after that;
# change the password in the app). ADMIN_PASSWORD at least 8 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator
ADMIN_EMAIL=

# ---- Optional -------------------------------------------------------------------------------

# Listen on this one server address only, for a server with several IPs (default: all of them).
# Usually the same as MEDIASOUP_ANNOUNCED_IP.
#NOVACONNECT_BIND_IP=

# Host ports for the web app (inside the container it listens on 8080 http / 8443 https).
# Rootless Podman needs net.ipv4.ip_unprivileged_port_start=0 to bind ports below 1024.
NOVACONNECT_HTTP_PORT=80
NOVACONNECT_HTTPS_PORT=443

# A demo workspace with sample users (admin/admin123, jdoe/member123, ...) instead of ADMIN_*,
# on an empty database only. For demos and testing; never on a real install.
SEED_DEMO=false

# Logging: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Media worker processes (one CPU core each); default one per core, at most 8.
#MEDIASOUP_WORKERS=

# File storage: local (the uploads volume) or s3
STORAGE_DRIVER=local
#S3_BUCKET=
#S3_REGION=
#S3_ENDPOINT=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_CDN_URL=
#S3_FORCE_PATH_STYLE=false
# Largest upload in bytes (default 100 MB)
#MAX_FILE_SIZE=104857600
# Days to keep meeting recordings (default 30)
#RECORDING_RETENTION_DAYS=30

# AI assistant and message translation (features stay off without keys)
#GEMINI_API_KEY=
#GEMINI_MODEL=
#GOOGLE_TRANSLATE_API_KEY=

# NovaDesk ITSM integration (server decommission workflow). Off unless NOVADESK_BASE_URL is set.
#   NOVADESK_BASE_URL    NovaDesk as reached from this server
#   NOVADESK_PUBLIC_URL  NovaDesk in users' browsers ("View Change" button)
#   SYNC_API_KEY         shared secret; NovaDesk must be given the same value
#NOVADESK_BASE_URL=
#NOVADESK_PUBLIC_URL=
#SYNC_API_KEY=

# OpenTelemetry traces (off unless set)
#OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Database migrations run automatically at startup; set false only to run them another way.
#MIGRATE_ON_START=true
