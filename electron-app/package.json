{
  "name": "novaconnect-desktop",
  "productName": "NovaConnect",
  "version": "1.0.2",
  "description": "NovaConnect desktop client for Windows — a thin native shell around the NovaConnect web app, the same architecture Teams/Slack/Discord desktop clients use.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "build": {
    "appId": "com.novaconnect.desktop",
    "productName": "NovaConnect",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "settings.html",
      "error.html",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NovaConnect"
    }
  }
}
