{
  "name": "novaconnect-desktop",
  "productName": "NovaConnect",
  "version": "1.0.6",
  "description": "NovaConnect desktop client for Windows and macOS — a thin native shell around the NovaConnect web app, the same architecture Teams/Slack/Discord desktop clients use.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "build": {
    "appId": "com.novaconnect.desktop",
    "productName": "NovaConnect",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "settings.html",
      "error.html",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NovaConnect"
    },
    "mac": {
      "appId": "com.novaconnect.mac",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "NovaConnect uses your camera for video meetings and calls.",
        "NSMicrophoneUsageDescription": "NovaConnect uses your microphone for meetings and calls.",
        "NSLocalNetworkUsageDescription": "NovaConnect connects to your organization's NovaConnect server on your local network."
      }
    },
    "dmg": {
      "artifactName": "NovaConnect-${version}-${arch}.dmg"
    },
    "afterPack": "scripts/sign-mac.js"
  }
}
