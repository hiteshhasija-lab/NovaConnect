<%- include('partials/head') %>
<%- include('partials/topbar') %>
<div class="container py-4 admin-audit">
  <h1 class="h4"><i class="bi bi-journal-text me-2"></i>Audit log</h1>
  <p class="mb-2"><a href="/admin/users">Users</a> · <a href="/admin/retention">Message retention</a> · <a href="/admin/holds">Legal hold</a> · <a href="/admin/reports">Chat concerns</a></p>
  <p class="text-muted small">Sign-ins, administration, team and channel changes, message deletions and retention, newest first. Times are UTC. The log keeps no message text and no passwords, and nothing in it can be changed or removed.</p>

  <form class="row g-2 align-items-end mb-3" method="GET" action="/admin/audit">
    <div class="col-sm-3">
      <label class="form-label small" for="auditGroup">What</label>
      <select class="form-select form-select-sm" id="auditGroup" name="group">
        <option value="">Everything</option>
        <% Object.entries(groups).forEach(([key, label]) => { %><option value="<%= key %>" <%= applied.group === key ? 'selected' : '' %>><%= label %></option><% }) %>
      </select>
    </div>
    <div class="col-sm-3">
      <label class="form-label small" for="auditPerson">Who</label>
      <select class="form-select form-select-sm" id="auditPerson" name="person">
        <option value="">Anyone</option>
        <% people.forEach(p => { %><option value="<%= p.id %>" <%= applied.person === p.id ? 'selected' : '' %>><%= p.full_name %> (@<%= p.username %>)</option><% }) %>
      </select>
    </div>
    <div class="col-sm-2"><label class="form-label small" for="auditFrom">From</label><input class="form-control form-control-sm" type="date" id="auditFrom" name="from" value="<%= applied.from || '' %>"></div>
    <div class="col-sm-2"><label class="form-label small" for="auditTo">To</label><input class="form-control form-control-sm" type="date" id="auditTo" name="to" value="<%= applied.to || '' %>"></div>
    <div class="col-sm-2 d-flex gap-2">
      <button class="btn btn-primary btn-sm" type="submit">Filter</button>
      <a class="btn btn-outline-secondary btn-sm" href="/admin/audit.csv?<%= query %>" title="Download these entries as CSV (up to 50,000)"><i class="bi bi-download"></i> CSV</a>
    </div>
  </form>

  <% if (!rows.length) { %><p>No entries<%= Object.keys(applied).length ? ' match these filters' : ' yet' %>.</p><% } else { %>
  <div class="table-responsive">
    <table class="table table-sm align-middle audit-table">
      <thead><tr><th scope="col">When (UTC)</th><th scope="col">Who</th><th scope="col">What</th><th scope="col">On</th><th scope="col">Details</th><th scope="col">From</th></tr></thead>
      <tbody>
      <% rows.forEach(r => { %>
        <tr class="<%= r.action === 'auth.login_failed' ? 'audit-failed' : '' %>">
          <td class="text-nowrap"><%= r.at %></td>
          <td><%= r.actor_name || (r.actor_id ? '#' + r.actor_id : '—') %></td>
          <td><%= actions[r.action] || r.action %></td>
          <td><%= r.target_name || (r.target_id ? (r.target_type || '') + ' #' + r.target_id : '') %></td>
          <td class="audit-details"><%= r.detailsText %></td>
          <td class="small text-muted"><%= r.ip || '' %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% if (olderLink) { %><a class="btn btn-outline-secondary btn-sm" href="<%= olderLink %>">Older entries</a><% } %>
  <% } %>
</div>
<%- include('partials/foot') %>
