<%- include('partials/head') %>
<div class="workspace">
  <div class="rail">
    <div class="rail-top">
      <button class="rail-btn" data-view="search" id="railSearch" title="Search">
        <i class="bi bi-search"></i><span>Search</span>
      </button>
      <button class="rail-btn" data-view="activity" id="railActivity" title="Activity">
        <i class="bi bi-bell-fill"></i><span>Activity</span>
        <span class="rail-badge d-none" id="activityBadge">0</span>
      </button>
      <button class="rail-btn" data-view="chat" id="railChat" title="Chat">
        <i class="bi bi-chat-dots-fill"></i><span>Chat</span>
      </button>
      <button class="rail-btn active" data-view="teams" id="railTeams" title="Teams">
        <i class="bi bi-people-fill"></i><span>Teams</span>
      </button>
      <button class="rail-btn" data-view="meet" id="railMeet" title="Meet"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="1" y="5" width="14" height="14" rx="4"/><path d="m16 9 5-3q2-1 2 1v10q0 2-2 1l-5-3z"/></svg><span>Meet</span></button>
      <button class="rail-btn" data-view="people" id="railPeople" title="People"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="9" cy="7" r="4"/><path d="M1 21v-3a8 8 0 0 1 16 0v3zM17 3a4 4 0 0 1 0 8 9 9 0 0 1 6 8v2h-4v-3a10 10 0 0 0-3-7 4 4 0 0 0 1-8z"/></svg><span>People</span></button>
      <button class="rail-btn" data-view="calendar" id="railCalendar" title="Calendar">
        <i class="bi bi-calendar3"></i><span>Calendar</span>
      </button>
      <button class="rail-btn" data-view="ai" id="railAI" title="Gemini">
        <%- include('partials/gemini-mark') %><span>Gemini</span>
      </button>
    </div>
    <div class="rail-bottom">
      <div class="dropdown dropup">
        <button class="rail-avatar-btn" data-bs-toggle="dropdown" aria-expanded="false" title="<%= currentUser.full_name %>">
          <span class="user-avatar"><%= h.initials(currentUser.full_name) %><img class="profile-photo" src="/api/profile-photo/<%= currentUser.id %>" alt=""></span>
          <span class="presence-dot presence-online" id="myPresenceDot"></span>
        </button>
        <div class="dropdown-menu user-menu" id="userMenu">
          <div class="user-menu-panel" id="userMenuMain">
            <div class="user-menu-account">
              <span class="user-avatar"><%= h.initials(currentUser.full_name) %><img class="profile-photo" src="/api/profile-photo/<%= currentUser.id %>" alt=""></span>
              <div class="user-menu-account-text">
                <div class="user-menu-account-name"><%= currentUser.full_name %></div>
                <div class="user-menu-account-email" id="userMenuEmail"></div>
              </div>
            </div>
            <div class="user-menu-status-message d-none" id="myStatusMessageDisplay"></div>
            <hr class="dropdown-divider">
            <button type="button" class="dropdown-item user-menu-expand-btn" id="statusRowBtn" aria-controls="userMenuStatusSub" aria-expanded="false">
              <span class="presence-dot presence-online" id="statusRowDot" aria-hidden="true"></span>
              <span id="statusRowLabel">Available</span>
              <i class="bi bi-chevron-right ms-auto"></i>
            </button>
          <div class="user-menu-panel d-none" id="userMenuStatusSub">
            <a class="dropdown-item presence-option" href="#" data-status="online"><span class="presence-dot presence-online" aria-hidden="true"></span> Available</a>
            <a class="dropdown-item presence-option" href="#" data-status="busy"><span class="presence-dot presence-busy" aria-hidden="true"></span> Busy</a>
            <a class="dropdown-item presence-option" href="#" data-status="dnd"><span class="presence-dot presence-dnd" aria-hidden="true"></span> Do not disturb</a>
            <a class="dropdown-item presence-option" href="#" data-status="brb"><span class="presence-dot presence-brb" aria-hidden="true"></span> Be right back</a>
            <a class="dropdown-item presence-option" href="#" data-status="away"><span class="presence-dot presence-away" aria-hidden="true"></span> Appear away</a>
            <a class="dropdown-item presence-option" href="#" data-status="offline"><span class="presence-dot presence-offline" aria-hidden="true"></span> Appear offline</a>
            <hr class="dropdown-divider">
            <a class="dropdown-item presence-option" href="#" data-status="reset"><i class="bi bi-arrow-counterclockwise me-2"></i> Reset status</a>
          </div>
            <a class="dropdown-item" href="#" id="setStatusMessageBtn"><i class="bi bi-chat-left-quote me-2"></i>Set status message</a>
            <a class="dropdown-item" href="#" id="oooMenuBtn" data-bs-toggle="modal" data-bs-target="#oooModal"><i class="bi bi-airplane me-2"></i><span id="oooMenuLabel">Schedule out of office</span></a>
            <hr class="dropdown-divider">
            <a class="dropdown-item" href="/profile"><i class="bi bi-person me-2"></i>My Profile</a>
            <% if (currentUser.role === 'admin') { %><a class="dropdown-item" href="/admin/users"><i class="bi bi-people me-2"></i>Manage Users</a><% } %>
            <a class="dropdown-item" href="#" id="toggleThemeBtn"><i class="bi bi-moon-stars me-2"></i>Toggle theme</a>
            <hr class="dropdown-divider">
            <h6 class="dropdown-header">Notifications</h6>
            <a class="dropdown-item pref-toggle-item" href="#" id="notifSoundToggle"><i class="bi bi-volume-up me-2"></i>Sound<i class="bi bi-check2 pref-toggle-check ms-auto"></i></a>
            <a class="dropdown-item pref-toggle-item" href="#" id="notifDesktopToggle"><i class="bi bi-window me-2"></i>Desktop notifications<i class="bi bi-check2 pref-toggle-check ms-auto"></i></a>
            <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#vipModal"><i class="bi bi-star me-2"></i>VIP people</a>
            <hr class="dropdown-divider">
            <h6 class="dropdown-header">Message display</h6>
            <a class="dropdown-item pref-toggle-item" href="#" id="densityCompactToggle"><i class="bi bi-arrows-collapse me-2"></i>Compact messages<i class="bi bi-check2 pref-toggle-check ms-auto"></i></a>
            <hr class="dropdown-divider">
            <form action="/logout" method="POST"><button class="dropdown-item text-danger" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Logout</button></form>
          </div>

        </div>
      </div>
      <div class="status-message-popover d-none" id="statusMessagePopover">
        <textarea id="statusMessageInput" maxlength="280" placeholder="What's your status?"></textarea>
        <div class="status-message-count"><span id="statusMessageCount">0</span>/280</div>
        <label>Clear after
          <select id="statusMessageClearAfter">
            <option value="never">Never</option>
            <option value="today">Today</option>
            <option value="1h">1 hour</option>
            <option value="4h">4 hours</option>
            <option value="week">This week</option>
          </select>
        </label>
        <div class="status-message-popover-actions">
          <button type="button" class="chat-action" id="statusMessageClearBtn">Clear</button>
          <button type="button" class="chat-action chat-action-primary" id="statusMessageSaveBtn">Done</button>
        </div>
      </div>
    </div>
  </div>

  <div class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <span id="sidebarTitle">Teams</span>
      <div class="sidebar-actions" id="sidebarActions"></div>
    </div>
    <div class="sidebar-body" id="sidebarBody"></div>
  </div>

  <div class="main-pane">
    <div class="main-header" id="mainHeader"></div>
    <div class="message-list" id="messageList"></div>
    <div class="typing-indicator d-none" id="typingIndicator"></div>
    <div class="ooo-notice d-none" id="oooNotice" role="status"></div>
    <div class="composer d-none" id="composer">
      <div class="composer-file-preview d-none" id="composerFilePreview"></div>
      <div class="composer-toolbar d-none" id="composerToolbar" role="toolbar" aria-label="Formatting">
        <button type="button" data-fmt="bold" title="Bold"><i class="bi bi-type-bold"></i></button>
        <button type="button" data-fmt="italic" title="Italic"><i class="bi bi-type-italic"></i></button>
        <button type="button" data-fmt="strike" title="Strikethrough"><i class="bi bi-type-strikethrough"></i></button>
        <span class="composer-toolbar-divider"></span>
        <button type="button" data-fmt="bullets" title="Bulleted list"><i class="bi bi-list-ul"></i></button>
        <button type="button" data-fmt="numbers" title="Numbered list"><i class="bi bi-list-ol"></i></button>
        <button type="button" data-fmt="quote" title="Quote"><i class="bi bi-quote"></i></button>
        <span class="composer-toolbar-divider"></span>
        <button type="button" data-fmt="code" title="Code"><i class="bi bi-code"></i></button>
        <button type="button" data-fmt="codeblock" title="Code block"><i class="bi bi-code-square"></i></button>
        <button type="button" data-fmt="link" title="Link"><i class="bi bi-link-45deg"></i></button>
        <span class="composer-toolbar-divider composer-announce-only"></span>
        <button type="button" class="composer-announce-only" id="composerAnnounceBtn" title="Post as an announcement" aria-pressed="false"><i class="bi bi-megaphone"></i></button>
      </div>
      <%# An announcement's banner (channels only; workspace.js, src/announcement.js). %>
      <div class="composer-announcement msg-announcement-blue d-none" id="composerAnnouncement">
        <input type="text" id="announceHeadline" maxlength="120" placeholder="Add a headline" aria-label="Announcement headline">
        <input type="text" id="announceSubhead" maxlength="200" placeholder="Add a subheading (optional)" aria-label="Announcement subheading">
        <div class="announce-themes" role="radiogroup" aria-label="Banner colour">
          <% ['blue', 'purple', 'green', 'orange', 'red', 'slate'].forEach(function (t, i) { %><button type="button" role="radio" class="announce-theme msg-announcement-<%= t %>" data-theme="<%= t %>" aria-checked="<%= i === 0 %>" aria-label="<%= t %>" title="<%= t[0].toUpperCase() + t.slice(1) %>"></button><% }) %>
        </div>
      </div>
      <div class="composer-row">
        <label class="composer-attach-btn" title="Attach a file">
          <i class="bi bi-paperclip"></i>
          <input type="file" id="composerFileInput" hidden>
        </label>
        <button type="button" class="composer-attach-btn" id="composerFormatBtn" title="Formatting options">
          <i class="bi bi-type"></i>
        </button>
        <button type="button" class="composer-attach-btn" id="composerWandBtn" title="Rewrite with Gemini">
          <i class="bi bi-magic"></i>
        </button>
        <button type="button" class="composer-attach-btn" id="composerEmojiBtn" title="Emoji">
          <i class="bi bi-emoji-smile"></i>
        </button>
        <textarea id="composerInput" class="composer-input" rows="1" placeholder="Type a message… (@ to mention)"></textarea>
        <button type="button" class="composer-attach-btn" id="composerScheduledBtn" title="Scheduled messages">
          <i class="bi bi-clock-history"></i><span class="composer-scheduled-badge d-none" id="composerScheduledBadge">0</span>
        </button>
        <button type="button" class="composer-attach-btn" id="composerScheduleBtn" title="Schedule send">
          <i class="bi bi-calendar-plus"></i>
        </button>
        <button class="composer-send-btn" id="composerSendBtn" title="Send"><i class="bi bi-send-fill"></i></button>
      </div>
      <div class="schedule-popover d-none" id="schedulePopover">
        <label>Send at<input type="datetime-local" id="scheduleAtInput"></label>
        <div class="schedule-popover-actions">
          <button type="button" class="chat-action" id="scheduleCancelBtn">Cancel</button>
          <button type="button" class="chat-action chat-action-primary" id="scheduleConfirmBtn">Schedule</button>
        </div>
        <p class="schedule-popover-error" id="scheduleError"></p>
      </div>
      <div class="mention-popover d-none" id="mentionPopover"></div>
      <div class="rewrite-popover d-none" id="rewritePopover"></div>
    </div>

    <section class="meet-pane d-none" id="meetPane" aria-label="Meet"></section>
    <div class="ai-pane d-none" id="aiPane">
      <div class="main-header">
        <div class="main-header-title"><%- include('partials/gemini-mark') %>Gemini<span class="main-header-sub">Private assistant — only you can see this</span></div>
        <button class="btn btn-sm btn-outline-secondary" id="aiNewChatBtn"><i class="bi bi-plus-lg me-1"></i>New chat</button>
      </div>
      <div class="ai-message-list" id="aiMessageList"></div>
      <div class="composer" id="aiComposer">
        <div class="composer-row">
          <textarea id="aiComposerInput" class="composer-input" rows="1" placeholder="Message Gemini…"></textarea>
          <button class="composer-send-btn" id="aiSendBtn" title="Send"><i class="bi bi-send-fill"></i></button>
        </div>
      </div>
    </div>

    <div class="calendar-pane d-none" id="calendarPane">
      <div class="main-header">
        <div class="calendar-nav">
          <button type="button" class="btn-plain" id="calPrevBtn" title="Previous month"><i class="bi bi-chevron-left"></i></button>
          <span class="calendar-month-label" id="calMonthLabel"></span>
          <button type="button" class="btn-plain" id="calNextBtn" title="Next month"><i class="bi bi-chevron-right"></i></button>
          <button type="button" class="btn btn-sm btn-outline-secondary" id="calTodayBtn">Today</button>
        </div>
        <button type="button" class="btn btn-sm btn-primary" id="calNewEventBtn"><i class="bi bi-plus-lg me-1"></i>New event</button>
      </div>
      <div class="calendar-weekdays">
        <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
      </div>
      <div class="calendar-grid" id="calendarGrid"></div>
    </div>
  </div>

  <div class="thread-panel d-none" id="threadPanel">
    <div class="thread-header">
      <span><i class="bi bi-chat-square-text me-2"></i>Thread</span>
      <button class="btn-plain" id="closeThreadBtn"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="thread-parent" id="threadParent"></div>
    <div class="thread-replies" id="threadReplies"></div>
    <div class="composer" id="threadComposer">
      <div class="composer-row">
        <textarea id="threadComposerInput" class="composer-input" rows="1" placeholder="Reply…"></textarea>
        <button class="composer-send-btn" id="threadSendBtn" title="Send"><i class="bi bi-send-fill"></i></button>
      </div>
    </div>
  </div>
</div>

<!-- Out of office modal (Teams' "Schedule out of office"): routes/users.js, presenceRules.js -->
<div class="modal fade" id="oooModal" tabindex="-1" aria-labelledby="oooModalTitle">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="oooModalTitle"><i class="bi bi-airplane me-2"></i>Out of office</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form class="modal-body" id="oooForm">
        <p class="text-muted small mb-3">While it's on, people see Out of office as your status, and your message on your profile card and when they write to you.</p>
        <div class="form-check form-switch mb-3">
          <input class="form-check-input" type="checkbox" role="switch" id="oooEnabled">
          <label class="form-check-label" for="oooEnabled">Turn on out of office</label>
        </div>
        <label class="form-label" for="oooMessage">Message</label>
        <textarea class="form-control mb-1" id="oooMessage" maxlength="500" rows="3" placeholder="I'm out of office, back on Monday."></textarea>
        <div class="text-muted small text-end mb-3"><span id="oooMessageCount">0</span>/500</div>
        <div class="form-check mb-2">
          <input class="form-check-input" type="checkbox" id="oooScheduled">
          <label class="form-check-label" for="oooScheduled">Only during a time period</label>
        </div>
        <div class="row g-2 mb-2 d-none" id="oooPeriod">
          <div class="col-sm-6"><label class="form-label small" for="oooStart">Start</label><input class="form-control" type="datetime-local" id="oooStart"></div>
          <div class="col-sm-6"><label class="form-label small" for="oooEnd">End</label><input class="form-control" type="datetime-local" id="oooEnd"></div>
        </div>
        <div class="alert alert-danger py-2 small d-none" id="oooError" role="alert"></div>
        <div class="d-flex justify-content-end gap-2 mt-3">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary" id="oooSaveBtn">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- VIP people (Teams' "priority access"): workspace.js, public/js/vip-rules.js -->
<div class="modal fade" id="vipModal" tabindex="-1" aria-labelledby="vipModalTitle">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="vipModalTitle"><i class="bi bi-star-fill me-2"></i>VIP people</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted small">Messages from these people always reach you: through Do not disturb and Presenting, and in chats and channels you set to "mentions only" or "off". Only you see this list.</p>
        <label class="form-label small" for="vipSearch">Add someone</label>
        <input type="search" class="form-control form-control-sm mb-2" id="vipSearch" placeholder="Search by name or username" autocomplete="off">
        <div class="vip-results mb-3" id="vipResults"></div>
        <div class="vip-list" id="vipList"></div>
      </div>
    </div>
  </div>
</div>

<!-- New / Join Team modal -->
<div class="modal fade" id="teamsModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-people-fill me-2"></i>Teams</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <ul class="nav nav-tabs mb-3" role="tablist">
          <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabJoin">Join a team</button></li>
          <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabCreate">Create a team</button></li>
        </ul>
        <div class="tab-content">
          <div class="tab-pane fade show active" id="tabJoin">
            <div id="browseTeamsList" class="list-group"></div>
          </div>
          <div class="tab-pane fade" id="tabCreate">
            <form id="createTeamForm">
              <div class="mb-3">
                <label class="form-label">Team name</label>
                <input type="text" name="name" class="form-control" required maxlength="60">
              </div>
              <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea name="description" class="form-control" rows="2" maxlength="200"></textarea>
              </div>
              <button type="submit" class="btn btn-primary w-100">Create team</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- New Channel modal -->
<div class="modal fade" id="channelModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-hash me-2"></i>New Channel</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="createChannelForm">
          <div class="mb-3">
            <label class="form-label">Channel name</label>
            <input type="text" name="name" class="form-control" required maxlength="40" placeholder="e.g. project-phoenix">
          </div>
          <div class="mb-3">
            <label class="form-label">Description</label>
            <input type="text" name="description" class="form-control" maxlength="200">
          </div>
          <div class="form-check mb-3">
            <input type="checkbox" name="is_private" class="form-check-input" id="channelPrivateCheck">
            <label class="form-check-label" for="channelPrivateCheck">Private channel</label>
          </div>
          <button type="submit" class="btn btn-primary w-100">Create channel</button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Team Members modal -->
<div class="modal fade" id="membersModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-people me-2"></i>Team Members</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="addMemberForm" class="d-flex gap-2 mb-3">
          <input type="text" name="username" class="form-control" placeholder="Add by username">
          <button type="submit" class="btn btn-outline-primary text-nowrap">Add</button>
        </form>
        <div id="membersList" class="list-group"></div>
      </div>
    </div>
  </div>
</div>

<!-- New / Edit Event modal -->
<div class="modal fade" id="eventModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="eventModalTitle"><i class="bi bi-calendar-plus me-2"></i>New Event</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="eventForm">
          <input type="hidden" name="id">
          <div class="mb-3">
            <label class="form-label">Team</label>
            <select name="team_id" class="form-select" id="eventTeamSelect" required></select>
          </div>
          <div class="mb-3">
            <label class="form-label">Title</label>
            <input type="text" name="title" class="form-control" required maxlength="120">
          </div>
          <div class="form-check mb-3">
            <input type="checkbox" name="all_day" class="form-check-input" id="eventAllDayCheck">
            <label class="form-check-label" for="eventAllDayCheck">All day</label>
          </div>
          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label">Starts</label>
              <input type="datetime-local" name="start_at" class="form-control" id="eventStartInput" required>
            </div>
            <div class="col-6">
              <label class="form-label">Ends</label>
              <input type="datetime-local" name="end_at" class="form-control" id="eventEndInput" required>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Location</label>
            <input type="text" name="location" class="form-control" maxlength="120" placeholder="Optional">
          </div>
          <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="2" maxlength="500"></textarea>
          </div>
          <div id="eventFormError" class="alert alert-danger py-2 small d-none"></div>
          <div class="d-flex justify-content-between">
            <button type="button" class="btn btn-outline-danger d-none" id="eventDeleteBtn"><i class="bi bi-trash me-1"></i>Delete</button>
            <button type="submit" class="btn btn-primary ms-auto">Save event</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Day Events modal (overflow list when a day has more events than fit in its cell) -->
<div class="modal fade" id="dayEventsModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="dayEventsModalTitle"><i class="bi bi-calendar3 me-2"></i>Events</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
