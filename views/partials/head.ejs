<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/png" href="/img/logo-mark.png">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · NovaConnect</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css?v=<%= h.cssVersion() %>" rel="stylesheet">
  <%# The blue/cyan theme overrides style.css's older purple defaults. Loaded here so the first paint
      is already blue (only at the end of <body>, pages flashed purple on every load and refresh);
      loaded again at the end of <body> (foot.ejs) so it still wins over the stylesheets pages add
      in <body>. Same file, so it's downloaded once. %>
  <link rel="stylesheet" href="/css/theme-blue-cyan.css?v=2">
  <script>
    (function () {
      var saved = localStorage.getItem('novaconnect-theme');
      var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-bs-theme', theme);
      document.documentElement.setAttribute('data-density', localStorage.getItem('novaconnect-density') === 'compact' ? 'compact' : 'comfortable');
    })();
  </script>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<div class="app-bg" aria-hidden="true">
  <div class="app-glow app-glow-1"></div>
  <div class="app-glow app-glow-2"></div>
  <div class="app-glow app-glow-3"></div>
</div>
