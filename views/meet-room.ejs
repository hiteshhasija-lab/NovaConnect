<% if (layout) { %>
<%- include('partials/head') %>
<% } %>
<link rel="stylesheet" href="/css/meet.css?v=20">
<link rel="stylesheet" href="/css/calls.css?v=29">
<main class="meet-room" data-code="<%= link.code %>">
  <header>
    <h1><%= link.title %></h1>
    <a href="/app" class="nc-btn-text">Back to NovaConnect</a>
  </header>
  <div class="meet-room-preview">
    <p>Meeting ID: <%= link.code %> · Group call</p>
    <!-- Before joining: your camera as others will see it, while it's on (meet-room.js). -->
    <div class="meet-prejoin" id="meetPrejoin">
      <video id="meetPreviewVideo" autoplay playsinline muted aria-label="Your camera preview"></video>
      <div class="meet-prejoin-off"><i class="bi bi-camera-video-off" aria-hidden="true"></i> Your camera is off</div>
    </div>
    <div class="meet-room-controls">
      <label><input id="meetMic" type="checkbox"> Microphone</label>
      <label><input id="meetCamera" type="checkbox"> Camera</label>
      <button class="btn btn-primary" id="meetEnter">Join meeting</button>
      <button class="btn btn-danger" id="meetLeave" hidden>Leave meeting</button>
      <button type="button" class="btn btn-outline-secondary" id="meetShare" hidden><i class="bi bi-display" aria-hidden="true"></i> <span>Share screen</span></button>
      <!-- In-call extras (call-extras.js): shown once you're in the meeting. -->
      <button type="button" class="btn btn-outline-secondary meet-extra-btn" id="meetParticipantsBtn" hidden aria-expanded="false" aria-controls="meetParticipantsPanel"><i class="bi bi-people" aria-hidden="true"></i> People <span class="nc-badge" id="meetParticipantsBadge" hidden>0</span></button>
      <button type="button" class="btn btn-outline-secondary meet-extra-btn" id="meetHandBtn" hidden aria-pressed="false" aria-label="Raise hand" title="Raise hand"><span aria-hidden="true">✋</span> Raise hand</button>
      <button type="button" class="btn btn-outline-secondary meet-extra-btn" id="meetReactionsBtn" hidden aria-expanded="false" aria-controls="meetReactionsPanel"><i class="bi bi-emoji-smile" aria-hidden="true"></i> React</button>
      <button type="button" class="btn btn-outline-secondary meet-extra-btn" id="meetChatBtn" hidden aria-expanded="false" aria-controls="meetChatPanel"><i class="bi bi-chat-dots" aria-hidden="true"></i> Chat <span class="nc-badge" id="meetChatBadge" hidden>0</span></button>
      <button type="button" class="btn btn-outline-secondary meet-extra-btn nc-captions-btn" id="meetCaptionsBtn" hidden aria-pressed="false" aria-label="Turn on live captions" title="Turn on live captions"><span class="nc-cc" aria-hidden="true">CC</span> Captions</button>
      <button type="button" class="btn btn-outline-secondary meet-extra-btn" id="meetBoardBtn" hidden aria-pressed="false"><i class="bi bi-easel" aria-hidden="true"></i> Whiteboard</button>
      <button type="button" class="btn btn-outline-secondary meet-extra-btn" id="meetTogetherBtn" hidden aria-pressed="false"><i class="bi bi-people-fill" aria-hidden="true"></i> Together mode</button>
      <button type="button" class="btn btn-outline-secondary meet-extra-btn" id="meetViewBtn" hidden><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i> <span>Large gallery</span></button>
      <button type="button" class="btn btn-outline-secondary meet-extra-btn" id="meetBreakoutBtn" hidden><i class="bi bi-door-open" aria-hidden="true"></i> Breakout rooms</button>
    </div>
    <details class="meet-devices">
      <summary><i class="bi bi-gear" aria-hidden="true"></i> Devices</summary>
      <div class="meet-device-grid">
        <label>Microphone <select id="meetMicSelect"></select></label>
        <label>Camera <select id="meetCameraSelect"></select></label>
        <label>Speaker <select id="meetSpeakerSelect"></select></label>
        <label id="meetBackgroundRow">Background <select id="meetBackgroundSelect"><option value="none">None</option><option value="blur">Blur</option></select></label>
      </div>
      <p class="meet-device-note">Remembered on this device. You can change these during the meeting too.</p>
    </details>
    <div class="meet-room-controls meet-recording-controls" id="recordingControls" hidden>
      <button type="button" class="btn btn-outline-danger" id="recordBtn" title="Start recording"><i class="bi bi-record-circle"></i> Record</button>
      <button type="button" class="btn btn-danger d-none" id="stopRecordBtn" title="Stop recording"><i class="bi bi-stop-circle"></i> Stop</button>
    </div>
    <p id="meetStatus" role="status">Choose your microphone and camera settings, then join.</p>
  </div>
  <div class="meet-lobby" id="meetLobby" hidden>
    <div class="meet-lobby-waiting">
      <div class="meet-lobby-spinner"></div>
      <p class="meet-lobby-message">Waiting for the meeting owner to let you in…</p>
    </div>
  </div>
  <aside class="meet-lobby-queue" id="meetLobbyQueue" hidden aria-live="polite">
    <h2>Waiting to join</h2>
    <ul id="meetLobbyList"></ul>
  </aside>
  <!-- A screen someone shares fills this stage; the participant tiles shrink to a strip below. -->
  <!-- While you're in a breakout room (meet-room.js): which one, time left, and the way back. -->
  <div class="meet-breakout-bar" id="meetBreakoutBar" role="status" hidden><i class="bi bi-door-open" aria-hidden="true"></i> <span></span> <button type="button" class="btn btn-sm btn-light">Return to main meeting</button></div>
  <section class="meet-share-stage" id="meetShareStage" hidden aria-label="Shared screen">
    <video id="meetShareVideo" autoplay playsinline muted></video>
    <p id="meetShareLabel"></p>
  </section>
  <!-- The shared whiteboard (whiteboard.js) takes the stage while it's open and nobody is sharing. -->
  <section class="meet-board-stage" id="meetBoardStage" hidden aria-label="Whiteboard"></section>
  <!-- Together mode (together.js): everyone seated in one scene while it's on. -->
  <section class="meet-together-stage" id="meetTogetherStage" hidden aria-label="Together mode"></section>
  <!-- A pinned or spotlighted person's tile moves here, shown large; the others shrink to a strip. -->
  <section class="meet-focus-stage" id="meetFocusStage" hidden aria-label="Pinned participant"></section>
  <div class="meet-videos" id="meetVideos"></div>
</main>
<div class="meet-notices" id="meetNotices" aria-live="polite"></div>
<!-- Live captions, for you when you turn them on (call-extras.js). -->
<div class="meet-captions" id="meetCaptions" aria-live="polite" hidden></div>
<aside class="nc-call-panel meet-side-panel" id="meetParticipantsPanel" role="complementary" aria-label="People in the meeting" hidden>
  <header><h3>People <span class="nc-badge" id="meetParticipantCount">0</span></h3><button type="button" class="nc-btn-close" aria-label="Close people">×</button></header>
  <div class="nc-participant-list" id="meetParticipantList"></div>
</aside>
<aside class="nc-call-panel meet-side-panel" id="meetReactionsPanel" role="complementary" aria-label="Reactions" hidden>
  <header><h3>Reactions</h3><button type="button" class="nc-btn-close" aria-label="Close reactions">×</button></header>
  <div class="nc-reaction-grid" id="meetReactionGrid"></div>
</aside>
<aside class="nc-call-panel meet-side-panel" id="meetChatPanel" role="complementary" aria-label="Meeting chat" hidden>
  <header><h3>Meeting chat</h3><button type="button" class="nc-btn-close" aria-label="Close chat">×</button></header>
  <div class="nc-chat-messages" id="meetChatMessages"></div>
  <form class="nc-chat-input" id="meetChatForm">
    <input type="text" id="meetChatInput" placeholder="Type a message…" autocomplete="off" aria-label="Chat message" maxlength="2000">
    <button type="submit" class="nc-btn-icon" aria-label="Send"><i class="bi bi-send" aria-hidden="true"></i></button>
  </form>
</aside>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/vendor/mediasoup-client.min.js?v=1"></script>
<script src="/js/sfu-client.js?v=7"></script>
<script src="/js/devices.js?v=2"></script>
<script src="/js/background-effects.js?v=2"></script>
<script src="/js/call-extras.js?v=8"></script>
<script src="/js/whiteboard.js?v=2"></script>
<script src="/js/together.js?v=2"></script>
<script src="/js/gallery.js?v=3"></script>
<script src="/js/breakout.js?v=1"></script>
<script src="/js/meet-room.js?v=27"></script>
<% if (layout) { %>
<%- include('partials/foot') %>
<% } %>
