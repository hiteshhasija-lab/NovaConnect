<% if (layout) { %>
<%- include('partials/head') %>
<% } %>
<link rel="stylesheet" href="/css/meet.css?v=2">
<link rel="stylesheet" href="/css/calls.css?v=3">
<main class="meet-room" data-code="<%= link.code %>">
  <header>
    <h1><%= link.title %></h1>
    <a href="/app" class="nc-btn-text">Back to NovaConnect</a>
  </header>
  <div class="meet-room-preview">
    <p>Meeting ID: <%= link.code %> · Group call (SFU) · Unlimited participants</p>
    <div class="meet-room-controls">
      <label><input id="meetMic" type="checkbox" checked> Microphone</label>
      <label><input id="meetCamera" type="checkbox" checked> Camera</label>
      <button class="btn btn-primary" id="meetEnter">Join meeting</button>
      <button class="btn btn-danger" id="meetLeave" hidden>Leave meeting</button>
    </div>
    <p id="meetStatus" role="status">Choose your microphone and camera settings, then join.</p>
  </div>
  <div class="meet-lobby" id="meetLobby" hidden>
    <div class="meet-lobby-waiting">
      <div class="meet-lobby-spinner"></div>
      <p class="meet-lobby-message">Waiting for host to admit you…</p>
    </div>
  </div>
  <div class="meet-videos" id="meetVideos"></div>
</main>
<%- include('call-panel') %>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/group-call.js?v=1"></script>
<script src="/js/meet-room.js?v=3"></script>
<% if (layout) { %>
<%- include('partials/foot') %>
<% } %>